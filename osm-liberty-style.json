{
  "version": 8,
  "name": "Algeria Multimodal",
  "metadata": {
    "mapbox:autocomposite": true,
    "mapbox:type": "template",
    "openmaptiles:version": "3.3"
  },
  "center": [5.5, 28.0],
  "zoom": 4,
  "bearing": 0,
  "pitch": 0,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://algeria"
    }
  },
  "sprite": "osm-liberty",
  "glyphs": "http://localhost:8080/fonts/{fontstack}/{range}.pbf",
  "layers": [

    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f8f6f1" }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#a8d0f0" }
    },

    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["in", "class", "river", "canal", "stream", "drain"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#74b3e0",
        "line-width": { "base": 1.3, "stops": [[6, 0.1], [8, 0.4], [10, 0.6], [12, 1.2], [14, 2.5]] }
      }
    },

    {
      "id": "landcover_sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "sand"],
      "paint": { "fill-color": "#f5e6c8", "fill-opacity": 0.9 }
    },

    {
      "id": "landcover_farmland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "farmland", "crop"],
      "paint": { "fill-color": "#eef0d5" }
    },

    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "forest"],
      "paint": { "fill-color": "#a8d5a2", "fill-opacity": 0.8 }
    },

    {
      "id": "landcover_wetland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wetland"],
      "paint": { "fill-color": "#b8ddc8", "fill-opacity": 0.75 }
    },

    {
      "id": "landcover_ice",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "ice"],
      "paint": { "fill-color": "#f0f8ff" }
    },

    {
      "id": "landcover_scrub",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "scrub"],
      "paint": { "fill-color": "#d4cdb8", "fill-opacity": 0.7 }
    },

    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": { "fill-color": "#c8e4b2" }
    },

    {
      "id": "landuse_national_park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": ["in", "class", "national_park", "nature_reserve", "protected_area"],
      "paint": { "fill-color": "#b8e0b0", "fill-opacity": 0.6 }
    },

    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "park"],
      "paint": { "fill-color": "#c8e4b2" }
    },

    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": { "fill-color": "#f0ebe6" }
    },

    {
      "id": "landuse_commercial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "commercial"],
      "paint": { "fill-color": "#f0e8e8" }
    },

    {
      "id": "landuse_industrial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "industrial"],
      "paint": { "fill-color": "#e8e0ec" }
    },

    {
      "id": "landuse_cemetery",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "cemetery"],
      "paint": { "fill-color": "#d6ddb8" }
    },

    {
      "id": "aeroway_fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "filter": ["==", "class", "apron"],
      "paint": { "fill-color": "#ddd8e8", "fill-opacity": 0.9 }
    },

    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#d6d0c8",
        "fill-outline-color": "#bbb4ac",
        "fill-opacity": { "base": 1, "stops": [[13, 0], [13.5, 1]] }
      }
    },

    {
      "id": "aeroway_runway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "filter": ["==", "class", "runway"],
      "layout": { "line-cap": "square" },
      "paint": {
        "line-color": "#c0bbd4",
        "line-width": { "stops": [[10, 2], [12, 6], [14, 14]] }
      }
    },

    {
      "id": "aeroway_taxiway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "filter": ["==", "class", "taxiway"],
      "paint": {
        "line-color": "#ccc8dc",
        "line-width": { "stops": [[10, 0.5], [12, 2], [14, 5]] }
      }
    },

    {
      "id": "road_bridge_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "brunnel", "bridge"],
        ["!in", "class", "rail", "transit", "aerialway", "gondola", "ferry", "path", "track"]
      ],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#a0a0a0",
        "line-width": { "base": 1.2, "stops": [[6, 2], [9, 4], [11, 6], [13, 9], [15, 12]] }
      }
    },

    {
      "id": "road_motorway_link",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "motorway"], ["==", "ramp", 1]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f0b840",
        "line-width": { "base": 1.2, "stops": [[12, 0], [13, 1.5], [14, 2.5], [15, 3.5], [16, 5]] }
      }
    },

    {
      "id": "road_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "motorway"], ["!=", "ramp", 1]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f0b840",
        "line-width": { "base": 1.2, "stops": [[4, 0.4], [6, 0.8], [8, 1.4], [10, 2], [12, 3], [14, 4], [16, 6]] }
      }
    },

    {
      "id": "road_trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f5c842",
        "line-width": { "base": 1.2, "stops": [[5, 0.3], [7, 0.8], [9, 1.4], [11, 2], [13, 2.8], [14, 3.5]] }
      }
    },

    {
      "id": "road_primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f5d060",
        "line-width": { "base": 1.2, "stops": [[6, 0.2], [8, 0.6], [10, 1.2], [12, 2], [13, 2.5], [14, 3]] }
      }
    },

    {
      "id": "road_secondary_tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f0e090",
        "line-width": { "base": 1.2, "stops": [[8, 0.2], [10, 0.6], [12, 1.2], [13, 1.6], [14, 2]] }
      }
    },

    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f0ede8",
        "line-width": { "base": 1.2, "stops": [[10, 0.3], [12, 0.8], [13, 1], [14, 1.4]] }
      }
    },

    {
      "id": "road_tunnel_overlay",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "brunnel", "tunnel"],
        ["!in", "class", "rail", "transit", "aerialway", "gondola", "ferry", "path"]
      ],
      "layout": { "line-cap": "butt", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.75,
        "line-width": { "base": 1.2, "stops": [[8, 1], [12, 2.5], [14, 4]] },
        "line-dasharray": [3, 3]
      }
    },

    {
      "id": "road_unpaved_overlay",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in", "surface",
        "unpaved", "gravel", "sand", "dirt",
        "ground", "compacted", "fine_gravel", "pebblestone"
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#c4a472",
        "line-opacity": 0.7,
        "line-width": { "base": 1.2, "stops": [[10, 0.5], [12, 1], [14, 1.5]] },
        "line-dasharray": [4, 2]
      }
    },

    {
      "id": "transit_ferry",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["==", "class", "ferry"],
      "layout": { "line-cap": "butt", "line-join": "round" },
      "paint": {
        "line-color": "#0099cc",
        "line-width": { "base": 1.2, "stops": [[6, 0.8], [8, 1.2], [10, 1.8], [12, 2.5]] },
        "line-dasharray": [6, 4]
      }
    },

    {
      "id": "transit_railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        ["in", "class", "rail", "transit"],
        ["!in", "subclass", "subway", "tram", "light_rail", "monorail", "funicular", "cable_car", "gondola"]
      ],
      "layout": { "line-cap": "butt", "line-join": "round" },
      "paint": {
        "line-color": "#8b1a1a",
        "line-width": { "base": 1.3, "stops": [[5, 0.4], [8, 1], [10, 1.6], [12, 2.4], [14, 3.5]] },
        "line-dasharray": [5, 2]
      }
    },

    {
      "id": "transit_light_rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["all", ["in", "class", "rail", "transit"], ["==", "subclass", "light_rail"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#e87722",
        "line-width": { "base": 1.3, "stops": [[10, 1], [12, 2.5], [13, 3.5], [14, 5]] }
      }
    },

    {
      "id": "transit_tram_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all", ["in", "class", "rail", "transit"], ["==", "subclass", "tram"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": { "base": 1.3, "stops": [[11, 3], [12, 5], [13, 7], [14, 9]] }
      }
    },

    {
      "id": "transit_tram",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all", ["in", "class", "rail", "transit"], ["==", "subclass", "tram"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#00933b",
        "line-width": { "base": 1.3, "stops": [[11, 1.5], [12, 3], [13, 4.5], [14, 6]] }
      }
    },

    {
      "id": "transit_subway_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["all", ["in", "class", "rail", "transit"], ["==", "subclass", "subway"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": { "base": 1.3, "stops": [[10, 4], [11, 5], [12, 7], [13, 9], [14, 12]] }
      }
    },

    {
      "id": "transit_subway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["all", ["in", "class", "rail", "transit"], ["==", "subclass", "subway"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#0055b3",
        "line-width": { "base": 1.3, "stops": [[10, 2], [11, 3], [12, 5], [13, 7], [14, 9]] }
      }
    },

    {
      "id": "transit_aerialway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["any", ["==", "class", "aerialway"], ["==", "class", "gondola"], ["in", "subclass", "gondola", "cable_car", "aerialway"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#7b2d8b",
        "line-width": { "base": 1.2, "stops": [[11, 1], [12, 1.5], [13, 2], [14, 3]] },
        "line-dasharray": [2, 3]
      }
    },

    {
      "id": "boundary_country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#8a909e",
        "line-width": { "base": 1.3, "stops": [[3, 0.5], [5, 1.2], [8, 2], [12, 2.5]] }
      }
    },

    {
      "id": "boundary_state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": {
        "line-color": "#b0b4be",
        "line-width": { "base": 1.2, "stops": [[4, 0.3], [7, 0.8], [10, 1.2], [12, 1.6]] },
        "line-dasharray": [6, 3]
      }
    },

    {
      "id": "transportation_ref",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 7,
      "filter": ["all", ["in", "class", "motorway", "trunk", "primary"], ["has", "ref"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "ref"],
        "text-font": ["Open Sans Bold", "Arial Unicode MS Bold"],
        "text-size": 9,
        "text-max-angle": 25,
        "text-padding": 10
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#f5d060",
        "text-halo-width": 2
      }
    },

    {
      "id": "transportation_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 10,
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary", "minor"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:ar"], ["get", "name:fr"], ["get", "name"]],
        "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
        "text-size": { "base": 1, "stops": [[10, 9], [13, 11], [14, 12]] },
        "text-max-angle": 30,
        "text-padding": 8
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },

    {
      "id": "water_name_ocean",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["==", "class", "ocean"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:ar"], ["get", "name:fr"], ["get", "name"]],
        "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
        "text-size": 14
      },
      "paint": { "text-color": "#4a90c4", "text-halo-color": "#cce8f8", "text-halo-width": 1 }
    },

    {
      "id": "water_name_lake",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": ["in", "class", "lake", "sea", "river"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:ar"], ["get", "name:fr"], ["get", "name"]],
        "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
        "text-size": 11
      },
      "paint": { "text-color": "#4a90c4", "text-halo-color": "#cce8f8", "text-halo-width": 1 }
    },

    {
      "id": "mountain_peak_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "mountain_peak",
      "minzoom": 9,
      "filter": ["<=", "rank", 3],
      "layout": {
        "text-field": [
          "concat",
          ["coalesce", ["get", "name:ar"], ["get", "name:fr"], ["get", "name"]],
          "\n",
          ["concat", ["to-string", ["get", "ele"]], "m"]
        ],
        "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
        "text-size": 10,
        "text-anchor": "top",
        "text-offset": [0, 0.3],
        "text-max-width": 8
      },
      "paint": { "text-color": "#666666", "text-halo-color": "#ffffff", "text-halo-width": 1 }
    },

    {
      "id": "aerodrome_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "aerodrome_label",
      "minzoom": 9,
      "layout": {
        "icon-image": "airport_11",
        "icon-size": 1.1,
        "text-field": [
          "case",
          ["has", "iata"],
          ["concat", ["coalesce", ["get", "name:ar"], ["get", "name:fr"], ["get", "name"]], " (", ["get", "iata"], ")"],
          ["coalesce", ["get", "name:ar"], ["get", "name:fr"], ["get", "name"]]
        ],
        "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
        "text-size": 10,
        "text-anchor": "top",
        "text-offset": [0, 0.9],
        "text-max-width": 12
      },
      "paint": { "text-color": "#4a4a7a", "text-halo-color": "#ffffff", "text-halo-width": 1 }
    },

    {
      "id": "poi_ferry_terminal",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 12,
      "filter": ["any", ["==", "class", "ferry"], ["==", "subclass", "ferry_terminal"]],
      "layout": {
        "icon-image": "ferry_11",
        "icon-size": 1.1,
        "text-field": ["coalesce", ["get", "name:ar"], ["get", "name:fr"], ["get", "name"]],
        "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
        "text-size": 10,
        "text-anchor": "top",
        "text-offset": [0, 0.9],
        "text-max-width": 10,
        "icon-allow-overlap": false,
        "text-optional": true
      },
      "paint": { "text-color": "#0077aa", "text-halo-color": "#ffffff", "text-halo-width": 1.5 }
    },

    {
      "id": "poi_aerialway_station",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 12,
      "filter": ["any", ["==", "class", "aerialway"], ["==", "subclass", "aerialway"]],
      "layout": {
        "icon-image": "aerialway_11",
        "icon-size": 1.2,
        "text-field": ["coalesce", ["get", "name:ar"], ["get", "name:fr"], ["get", "name"]],
        "text-font": ["Open Sans Bold", "Arial Unicode MS Bold"],
        "text-size": 10,
        "text-anchor": "top",
        "text-offset": [0, 0.9],
        "text-max-width": 10,
        "icon-allow-overlap": false,
        "text-optional": true
      },
      "paint": { "text-color": "#7b2d8b", "text-halo-color": "#ffffff", "text-halo-width": 2 }
    },

    {
      "id": "poi_bus_stop",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "filter": ["all", ["==", "class", "bus"], ["==", "subclass", "bus_stop"]],
      "layout": {
