{
  "options": {
    "styles": {
      "osm-liberty": {
        "tilejson": "2.2.0",
        "name": "OSM Bright",
        "attribution": "© OpenStreetMap contributors",
        "minzoom": 0,
        "maxzoom": 14,
        "center": [
          5.5,
          28.0,
          4
        ],
        "layers": [
          {
            "id": "background",
            "type": "background"
          },
          {
            "id": "landuse-park",
            "source": "openmaptiles",
            "source-layer": "landuse",
            "type": "fill",
            "paint": {
              "fill-color": "#d2edae"
            }
          },
          {
            "id": "water",
            "source": "openmaptiles",
            "source-layer": "water",
            "type": "fill",
            "paint": {
              "fill-color": "#c8e6f8"
            }
          },
          {
            "id": "road-primary",
            "source": "openmaptiles",
            "source-layer": "road",
            "type": "line",
            "filter": [
              "==",
              "class",
              "primary"
            ],
            "paint": {
              "line-color": "#ffd966",
              "line-width": {
                "base": 1.2,
                "stops": [
                  [
                    5,
                    0.5
                  ],
                  [
                    7,
                    1
                  ],
                  [
                    10,
                    2
                  ],
                  [
                    13,
                    3
                  ]
                ]
              }
            }
          },
          {
            "id": "road-secondary",
            "source": "openmaptiles",
            "source-layer": "road",
            "type": "line",
            "filter": [
              "==",
              "class",
              "secondary"
            ],
            "paint": {
              "line-color": "#ffed99",
              "line-width": {
                "base": 1.2,
                "stops": [
                  [
                    6,
                    0.3
                  ],
                  [
                    8,
                    0.8
                  ],
                  [
                    11,
                    1.5
                  ]
                ]
              }
            }
          },
          {
            "id": "road-minor",
            "source": "openmaptiles",
            "source-layer": "road",
            "type": "line",
            "filter": [
              "!=",
              "class",
              "primary"
            ],
            "paint": {
              "line-color": "#ffffff",
              "line-width": {
                "base": 1.2,
                "stops": [
                  [
                    8,
                    0.3
                  ],
                  [
                    11,
                    0.8
                  ]
                ]
              }
            }
          },
          {
            "id": "building",
            "source": "openmaptiles",
            "source-layer": "building",
            "type": "fill",
            "paint": {
              "fill-color": "#dcdcdc"
            }
          },
          {
            "id": "place-label",
            "source": "openmaptiles",
            "source-layer": "place",
            "type": "symbol",
            "layout": {
              "text-field": [
                "get",
                "name"
              ],
              "text-size": 12,
              "text-font": [
                "Open Sans Regular",
                "Arial Unicode MS Regular"
              ]
            },
            "paint": {
              "text-color": "#333333",
              "text-halo-color": "#ffffff",
              "text-halo-width": 1
            }
          }
        ],
        "sources": {
          "openmaptiles": {
            "type": "vector",
            "url": "mbtiles://algeria"
          }
        },
        "sprite": "",
        "glyphs": "http://localhost:8080/data/glyphs/{fontstack}/{range}.pbf"
      }
    },
    "data": {
      "algeria": {
        "mbtiles": "algeria.mbtiles"
      }
    }
  },
  "port": 8080,
  "host": "0.0.0.0",
  "public_url": "http://localhost:8080",
  "allow_cors": true,
  "cors_url": "*",
  "cache": 3600
